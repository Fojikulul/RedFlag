# Copy this file to .dev.vars and put your real keys in it. .dev.vars is
# ignored by git, so the keys never end up in the repository.

# Free from api.data.gov/signup. Used to import FTC Do Not Call reports for
# the phone number lookup.
FTC_API_KEY=your-key-here

# Optional. From Google AI Studio (aistudio.google.com), with billing on.
# Used only for the phone number web search; without it, lookups use FTC
# reports alone.
# GEMINI_API_KEY=your-key-here

# Only needed if AI_PROVIDER is "claude" in wrangler.toml.
# ANTHROPIC_API_KEY=your-key-here
