{
  "name": "redflag-ai",
  "version": "1.0.0",
  "description": "Cloudflare Worker that serves RedFlag, runs the AI check and looks up phone numbers.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "db:init": "wrangler d1 execute redflag-stats --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute redflag-stats --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
